{
  "ConnectionStrings": {
    "Plastoids": "Server=localhost;Port=3306;Database=plastoids;User=plastoids;Password=plastoids;",
    "Redis": "localhost:6379"
  },
  "MySql": {
    "ServerVersion": "8.4.0-mysql"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ClientId": "plastoids-api",
    "DefaultPartitions": 6,
    "ReplicationFactor": 1,
    "ConsumersEnabled": true
  },
  "BlobStorage": {
    "ServiceUrl": "http://localhost:9000",
    "Bucket": "plastoids",
    "AccessKey": "plastoids",
    "SecretKey": "plastoids-secret"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Diagnostics": {
    "Enabled": false
  },
  "Otlp": {
    "Endpoint": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Quartz": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Issuer": "https://plastoids.ng",
    "Audience": "plastoids-api",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "MfaChallengeMinutes": 5
  },
  "Sms": {
    "Provider": "fake",
    "SenderId": "Plastoids"
  },
  "Admin": {
    "IpAllowList": []
  },
  "Seed": {
    "Enabled": false
  },
  "Secrets": {
    "JwtSigningKey": "",
    "FieldEncryptionKey": "",
    "BlindIndexKey": ""
  },
  "Payments": {
    "CallbackBaseUrl": "http://localhost:5080/api/v1/payments/return"
  }
}
