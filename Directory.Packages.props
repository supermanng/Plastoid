<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Microsoft / EF -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="9.0.23" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.23" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.23" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="9.0.23" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.23" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.23" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.23" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.23" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="9.0.23" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.23" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <!-- MySQL -->
    <PackageVersion Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <PackageVersion Include="EFCore.NamingConventions" Version="9.0.0" />
    <!-- Mediation / validation -->
    <PackageVersion Include="MediatR" Version="12.5.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <!-- Messaging / jobs / cache / storage -->
    <PackageVersion Include="Confluent.Kafka" Version="2.16.0" />
    <PackageVersion Include="Quartz.Extensions.Hosting" Version="3.22.11" />
    <PackageVersion Include="StackExchange.Redis" Version="2.13.23" />
    <PackageVersion Include="AWSSDK.S3" Version="4.1.2" />
    <!-- Observability -->
    <PackageVersion Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.13.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.13.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.13.0" />
    <!-- Health -->
    <PackageVersion Include="AspNetCore.HealthChecks.MySql" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.Kafka" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <PackageVersion Include="FluentAssertions" Version="7.2.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Testcontainers.MySql" Version="4.17.0" />
    <PackageVersion Include="Testcontainers.Kafka" Version="4.17.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.17.0" />
  </ItemGroup>
</Project>